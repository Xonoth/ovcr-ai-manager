{
  "name": "ai-manager",
  "version": "1.6.0",
  "description": "[OVCR] AI Manager - gestionnaire multi-comptes IA",
  "main": "main.js",
  "author": "X'o-noth",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:electron": "node test/integration/run.js",
    "test:perf": "electron --js-flags=--expose-gc test/integration/perf.js",
    "test:fuses": "node test/packaged/fuses.js",
    "test:cookies": "node --disable-warning=ExperimentalWarning test/packaged/cookies.js",
    "lint": "eslint .",
    "dist": "node scripts/dist.js"
  },
  "keywords": [],
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "10.0.1",
    "electron": "45.3.2",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "dependencies": {
    "monaco-editor": "^0.45.0"
  },
  "build": {
    "appId": "com.aimanager.workbench",
    "productName": "[OVCR] AI Manager",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/monaco-editor/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "OVCR-AI-Manager-${version}.exe"
    }
  }
}
