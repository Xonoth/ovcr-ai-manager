{
  "name": "ai-manager",
  "version": "1.3.0",
  "description": "[OVCR] AI Manager - gestionnaire multi-comptes IA",
  "main": "main.js",
  "author": "X'o-noth",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:electron": "node test/integration/run.js",
    "test:perf": "electron --js-flags=--expose-gc test/integration/perf.js",
    "lint": "eslint .",
    "dist": "electron-packager . \"[OVCR] AI Manager\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --app-version=1.3.0 --asar.unpack=**/monaco-editor/** --ignore=\"monaco-editor/(dev|esm|min-maps)\" --ignore=\"monaco-editor/(CHANGELOG|ThirdPartyNotices|README)\" --ignore=\"editor\\.main\\.nls\\.[a-z-]+\\.js\" --ignore=\"^/(PROJECT_CONTEXT\\.md|README\\.md|SECURITY\\.md|TESTS-MANUELS\\.md|PHASE-3\\.md|THIRD-PARTY-NOTICES\\.md|DISTRIBUTION-LISEZ-MOI\\.txt|\\.gitignore)$\" --ignore=\"^/test($|/)\" --ignore=\"^/eslint\\.config\\.js$\" && node scripts/prune-locales.js"
  },
  "keywords": [],
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "10.0.1",
    "electron": "45.3.2",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "dependencies": {
    "monaco-editor": "^0.45.0"
  },
  "build": {
    "appId": "com.aimanager.workbench",
    "productName": "[OVCR] AI Manager",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/monaco-editor/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "OVCR-AI-Manager-${version}.exe"
    }
  }
}
